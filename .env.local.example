# ── Firebase (client) ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin + billing (server) ─────────────────────────────
FIREBASE_SERVICE_ACCOUNT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Gmail SMTP is the free default) ────────────────────────
# Required for any email to send:
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_UNSUB_SECRET=          # long random string: openssl rand -hex 32
# Optional:
PAYMENTS_EMAIL=              # internal payout-request alerts; unset → skipped
EMAIL_PROVIDER=              # defaults to "gmail"; only set to switch providers
EMAIL_FROM=                  # e.g. "Impact Loop" <no-reply@yourdomain.com>; defaults to GMAIL_USER

# ── Cron ──────────────────────────────────────────────────────────
CRON_SECRET=                 # long random string; Vercel Cron authenticates with it

# ── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=        # your deployed URL; defaults to https://impactloop.vercel.app